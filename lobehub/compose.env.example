# Import into this stack's Portainer Environment; fill every blank.
# Never commit real values. generate-secrets.mjs writes compose.env.local (ignored).
LOBEHUB_POSTGRES_PASSWORD=
LOBEHUB_KEY_VAULTS_SECRET=
LOBEHUB_AUTH_SECRET=
LOBEHUB_JWKS_KEY=
LOBEHUB_JWKS_PUBLIC_KEY=
LOBEHUB_GATEWAY_SERVICE_TOKEN=
LOBEHUB_AUTH_ALLOWED_EMAILS=
LOBEHUB_NEWAPI_API_KEY=
LOBEHUB_S3_ACCESS_KEY_ID=
LOBEHUB_S3_SECRET_ACCESS_KEY=

# All other settings have the following defaults in docker-compose.yml.
# LOBEHUB_APP_URL=https://lobehub.dfder.tw
# LOBEHUB_HOST_PORT=43069
# LOBEHUB_AGENT_GATEWAY_URL=https://lobe-agent.dfder.tw
# LOBEHUB_AGENT_GATEWAY_HOST_PORT=43070
# LOBEHUB_DEVICE_GATEWAY_URL=https://lobe-device.dfder.tw
# LOBEHUB_DEVICE_GATEWAY_HOST_PORT=43071
# Gateway 0.5.0: trusted clients ONLY. Keep loopback until NPM source ACLs are configured.
# Remote NPM on TrueNAS requires 192.168.10.13 AFTER those restrictions are in place.
# LOBEHUB_GATEWAY_BIND_IP=127.0.0.1
# LOBEHUB_S3_ENDPOINT=https://s3.api.dfder.tw
# LOBEHUB_S3_BUCKET=s3-tmp
# LOBEHUB_NEWAPI_PROXY_URL=http://192.168.10.13:43001
# LOBEHUB_CHAT_MODEL=deepseek-v4-flash
# Changing CHAT_MODEL updates DEFAULT_AGENT_CONFIG, SYSTEM_AGENT and the default model list.
# Set a custom model list only when additional selectable models are wanted.
# LOBEHUB_NEWAPI_MODEL_LIST=-all,+deepseek-v4-flash,+gpt-4.1-mini
# LOBEHUB_CHATSTACK_NETWORK=chatstack_default
# LOBEHUB_SSRF_ALLOW_IP_ADDRESS_LIST=192.168.10.13,192.168.10.10
# LOBEHUB_IMAGE=lobehub/lobehub:2.2.21@sha256:01805eca5372cf4c99a7e895990596050959d68d890a3433015ced9fe538676e
# LOBEHUB_GATEWAY_IMAGE=ghcr.io/lobehub/lobehub-gateway:0.5.0@sha256:63647fd8f97407dafd344dd08b509ff74a033b23292cf1d451d804cb09d35759
