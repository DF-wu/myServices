# 英國節點：保留 gluetun-uk 與 19020/19021，相容 free-codex 與 Homepage。
COMPOSE_PROJECT_NAME=ddns-vpn-proxy-uk
VPN_CONFIG_DIR=/mnt/appdata/gluetun/surfshark-ovpn
VPN_CONFIG_FILE=uk-lon.prod.surfshark.com_udp.ovpn
GLUETUN_CONTAINER_NAME=gluetun-uk
VPROXY_CONTAINER_NAME=gluetun-uk-vproxy

# free-codex 的兩份替代 compose 都使用同一容器名 codex-runner；目前 runtime 未執行。
DEPENDENT_CONTAINER_NAME=codex-runner

HTTP_PROXY_PORT=19020
SHADOWSOCKS_TCP_PORT=19021
SHADOWSOCKS_UDP_PORT=19021
SOCKS5_PROXY_PORT=19120
