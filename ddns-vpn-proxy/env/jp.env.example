# 日本節點：保留 gluetun-jp 與 19010/19011，相容 oci-bot-client 與 Homepage。
COMPOSE_PROJECT_NAME=ddns-vpn-proxy-jp
VPN_CONFIG_DIR=/mnt/appdata/gluetun/surfshark-ovpn
VPN_CONFIG_FILE=jp-tok.prod.surfshark.com_udp.ovpn
GLUETUN_CONTAINER_NAME=gluetun-jp
VPROXY_CONTAINER_NAME=gluetun-jp-vproxy

# runtime 唯讀盤點確認 oci-bot-client 正在共用 gluetun-jp namespace。
# DDNS restart 後 watcher 只會在它原本 running 時重啟，使其加入新 namespace。
DEPENDENT_CONTAINER_NAME=oci-bot-client

HTTP_PROXY_PORT=19010
SHADOWSOCKS_TCP_PORT=19011
SHADOWSOCKS_UDP_PORT=19011
SOCKS5_PROXY_PORT=19110
