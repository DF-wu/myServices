# 羅馬尼亞節點：保留 gluetun-romania 與 19015/19016/19017。
COMPOSE_PROJECT_NAME=ddns-vpn-proxy-romania
VPN_CONFIG_DIR=/mnt/appdata/gluetun/surfshark-ovpn
VPN_CONFIG_FILE=ro-buc.prod.surfshark.com_udp.ovpn
GLUETUN_CONTAINER_NAME=gluetun-romania
VPROXY_CONTAINER_NAME=gluetun-romania-vproxy

# repo 與 runtime 都未找到 container:gluetun-romania consumer。
DEPENDENT_CONTAINER_NAME=

HTTP_PROXY_PORT=19015
SHADOWSOCKS_TCP_PORT=19016
# 舊 compose 為解決衝突刻意把 UDP 放在 19017，這裡原樣保留。
SHADOWSOCKS_UDP_PORT=19017
SOCKS5_PROXY_PORT=19115
