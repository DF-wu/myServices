# 三個地區共用的非地區設定。
# 實際部署前複製成 .env.common 並 chmod 600；.gitignore 已排除真正的 secrets。

# 時區與 VPN 模式。既有 WireGuard country selection 無法直接提供 hostname profile；
# 本次相容部署改用已存在且符合 single-remote 契約的 Surfshark OpenVPN profiles。
TZ=Asia/Taipei
VPN_TYPE=openvpn

# Surfshark OpenVPN profile 含 auth-user-pass，兩值都必須設定。
# 請勿把真正帳密提交進 Git。
OPENVPN_USER=
OPENVPN_PASSWORD=

# DDNS hostname 留空時，helper 會從各地區 profile 的 remote 自動取得。
DDNS_HOSTNAME=
DDNS_POLL_SECONDS=60
DDNS_INIT_RETRY_SECONDS=5
DDNS_RESOLVER=

# 保留舊部署的 LAN bind 契約。因為不是 127.0.0.1，init gate 會要求 HTTP、SOCKS5
# 與 Shadowsocks 都有認證；空白 secrets 會安全地阻止 Gluetun 啟動。
PROXY_BIND_ADDRESS=0.0.0.0

# Gluetun HTTP CONNECT proxy（沿用舊 8888 container port）。
HTTPPROXY=on
HTTPPROXY_USER=
HTTPPROXY_PASSWORD=
HTTPPROXY_STEALTH=off

# vproxy SOCKS5/TCP（每區使用新的 191xx host port）。
SOCKS5_USER=
SOCKS5_PASSWORD=
VPROXY_LOG=info

# 相容舊 Compose 的 Shadowsocks 8388/tcp+udp。Password 在公開 bind 時必填。
SHADOWSOCKS=on
SHADOWSOCKS_LOG=off
SHADOWSOCKS_PASSWORD=
SHADOWSOCKS_CIPHER=chacha20-ietf-poly1305

# Watcher 與 Gluetun runtime 調校。
GLUETUN_RESTART_TIMEOUT_SECONDS=20
GLUETUN_HEALTH_TIMEOUT_SECONDS=120
OPENVPN_VERBOSITY=1
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# 固定上游版本，避免 latest 在未 review 下改變行為。
GLUETUN_IMAGE=qmcgaw/gluetun:v3.41.1
DDNS_HELPER_IMAGE=docker:29.6.1-cli-alpine3.24
VPROXY_IMAGE=ghcr.io/0x676e67/vproxy:v2.5.5
SOCKET_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy:v0.4.2

# 僅供測試；production 必須留空，讓 helper 查詢真實 DNS。
DDNS_OVERRIDE_IPS=

# WireGuard future-use defaults；目前三區的 env 都選 openvpn。
WIREGUARD_ALLOWED_IPS=0.0.0.0/0
WIREGUARD_PERSISTENT_KEEPALIVE_INTERVAL=0
WIREGUARD_MTU=1320
WIREGUARD_IMPLEMENTATION=auto
