# 三個地區共用的非地區設定。
# Portainer Git Stack 請使用 portainer/{jp,romania,uk}.env.example 的單一合併 env；
# 本檔保留給人工 review 與 legacy CLI preflight，不含任何真正 secrets。

# 時區與 VPN 模式。既有 WireGuard country selection 無法直接提供 hostname profile；
# 本次相容部署改用已存在且符合 single-remote 契約的 Surfshark OpenVPN profiles。
TZ=Asia/Taipei
VPN_TYPE=openvpn

# Surfshark/OpenVPN、HTTP proxy 與 Shadowsocks credentials 不進 Portainer env。
# Installer 從 /home/df/.config/ddns-vpn-proxy/credentials/{jp,romania,uk}/ 讀取
# owner-only files，驗證後以 secret-file bind 注入；PRIVATE_REGION、profile filename
# 與 VPN_SOURCE_SHA256 都由各 region file 鎖定。

# DDNS hostname 留空時，helper 會從各地區 profile 的 remote 自動取得。
DDNS_HOSTNAME=
DDNS_POLL_SECONDS=60
DDNS_INIT_RETRY_SECONDS=5
DDNS_INIT_TIMEOUT_SECONDS=120
DDNS_RESOLVER=

# Production 預設只綁 host loopback。若需跨主機使用，應透過受控 tunnel/forward，
# 不要在 Portainer 將它改成 0.0.0.0。
PROXY_BIND_ADDRESS=127.0.0.1

# Gluetun HTTP CONNECT proxy（沿用舊 8888 container port）。Credentials 由 private
# secret files 注入；Portainer env 不得包含 HTTPPROXY_USER/PASSWORD。
HTTPPROXY=on
HTTPPROXY_STEALTH=off

# GOST SOCKS5/TCP（每區使用新的 191xx host port）。Proxy 綁在 loopback，
# 不啟用 credentials；不要在 Portainer env 加 SOCKS5_USER/PASSWORD。

# 相容舊 Compose 的 Shadowsocks 8388/tcp+udp。Password 由 private secret file 注入。
SHADOWSOCKS=on
SHADOWSOCKS_LOG=off
SHADOWSOCKS_CIPHER=chacha20-ietf-poly1305

# Watcher 與 Gluetun runtime 調校。Control API key 與 status-only role 由資產
# installer 在 Git/Portainer env 外建立，不要把 key 加進本檔。
GLUETUN_HEALTH_TIMEOUT_SECONDS=120
OPENVPN_VERBOSITY=1
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# 上游 image 與 multi-arch digest 直接固定在 Compose，Portainer env 無法繞過 review 覆寫。

# 僅供測試；production 必須留空，讓 helper 查詢真實 DNS。
DDNS_OVERRIDE_IPS=
