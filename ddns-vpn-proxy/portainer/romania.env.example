# Portainer Stack environment — Romania. This is intentionally one merged file.
# Credentials are host-side private files; this merged Portainer env must contain no secrets.
COMPOSE_PROJECT_NAME=ddns-vpn-proxy-romania
PRIVATE_REGION=romania
TZ=Asia/Taipei
VPN_TYPE=openvpn
VPN_CONFIG_FILE=ro-buc.prod.surfshark.com_udp.ovpn
VPN_SOURCE_SHA256=4766944557b366f52abc623aa46aa2577ea03a4f6e6f013ed28f8164ea8174e1
GLUETUN_CONTAINER_NAME=gluetun-romania
VPROXY_CONTAINER_NAME=gluetun-romania-vproxy
HTTP_PROXY_PORT=19015
SOCKS5_PROXY_PORT=19115
SHADOWSOCKS_TCP_PORT=19016
SHADOWSOCKS_UDP_PORT=19017

DDNS_HOSTNAME=
DDNS_POLL_SECONDS=60
DDNS_INIT_RETRY_SECONDS=5
DDNS_INIT_TIMEOUT_SECONDS=120
DDNS_RESOLVER=
DDNS_OVERRIDE_IPS=

PROXY_BIND_ADDRESS=127.0.0.1
HTTPPROXY=on
HTTPPROXY_STEALTH=off
SHADOWSOCKS=on
SHADOWSOCKS_LOG=off
SHADOWSOCKS_CIPHER=chacha20-ietf-poly1305

GLUETUN_HEALTH_TIMEOUT_SECONDS=120
OPENVPN_VERBOSITY=1
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
