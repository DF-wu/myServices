# Portainer Stack environment — Japan. This is intentionally one merged file.
# Credentials are host-side private files; this merged Portainer env must contain no secrets.
COMPOSE_PROJECT_NAME=ddns-vpn-proxy-jp
PRIVATE_REGION=jp
TZ=Asia/Taipei
VPN_TYPE=openvpn
VPN_CONFIG_FILE=jp-tok.prod.surfshark.com_udp.ovpn
VPN_SOURCE_SHA256=32805d1325c6ac9364c9370a48c314dc5701547ac1de1246f6a8f9a0c0bae648
GLUETUN_CONTAINER_NAME=gluetun-jp
VPROXY_CONTAINER_NAME=gluetun-jp-vproxy
HTTP_PROXY_PORT=19010
SOCKS5_PROXY_PORT=19110
SHADOWSOCKS_TCP_PORT=19011
SHADOWSOCKS_UDP_PORT=19011

DDNS_HOSTNAME=
DDNS_POLL_SECONDS=60
DDNS_INIT_RETRY_SECONDS=5
DDNS_INIT_TIMEOUT_SECONDS=120
DDNS_RESOLVER=
DDNS_OVERRIDE_IPS=

PROXY_BIND_ADDRESS=127.0.0.1
HTTPPROXY=on
HTTPPROXY_STEALTH=off
SHADOWSOCKS=on
SHADOWSOCKS_LOG=off
SHADOWSOCKS_CIPHER=chacha20-ietf-poly1305

GLUETUN_HEALTH_TIMEOUT_SECONDS=120
OPENVPN_VERBOSITY=1
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
