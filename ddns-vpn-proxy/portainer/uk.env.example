# Portainer Stack environment — United Kingdom. This is intentionally one merged file.
# Credentials are host-side private files; this merged Portainer env must contain no secrets.
COMPOSE_PROJECT_NAME=ddns-vpn-proxy-uk
PRIVATE_REGION=uk
TZ=Asia/Taipei
VPN_TYPE=openvpn
VPN_CONFIG_FILE=uk-lon.prod.surfshark.com_udp.ovpn
VPN_SOURCE_SHA256=52e38544276aeaf4d0bbcba8821778ee8105a02ef681bf678850121fbccc03d2
GLUETUN_CONTAINER_NAME=gluetun-uk
VPROXY_CONTAINER_NAME=gluetun-uk-vproxy
HTTP_PROXY_PORT=19020
SOCKS5_PROXY_PORT=19120
SHADOWSOCKS_TCP_PORT=19021
SHADOWSOCKS_UDP_PORT=19021

DDNS_HOSTNAME=
DDNS_POLL_SECONDS=60
DDNS_INIT_RETRY_SECONDS=5
DDNS_INIT_TIMEOUT_SECONDS=120
DDNS_RESOLVER=
DDNS_OVERRIDE_IPS=

PROXY_BIND_ADDRESS=127.0.0.1
HTTPPROXY=on
HTTPPROXY_STEALTH=off
SHADOWSOCKS=on
SHADOWSOCKS_LOG=off
SHADOWSOCKS_CIPHER=chacha20-ietf-poly1305

GLUETUN_HEALTH_TIMEOUT_SECONDS=120
OPENVPN_VERBOSITY=1
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
