global
    log stdout format raw daemon "${LOG_LEVEL}"
    pidfile /run/haproxy.pid
    maxconn 256

defaults
    mode http
    log global
    option httplog
    option dontlognull
    option http-server-close
    timeout http-request 10s
    timeout connect 10s
    timeout client 30s
    timeout server 30s

backend docker-socket
    server docker /var/run/docker.sock

frontend docker-api
    bind :2375

    # Docker CLI 會先以 /_ping 協商 API version。
    acl ping_method method GET HEAD
    acl ping_path path_reg -i ^(/v[0-9.]+)?/_ping$

    # Gluetun 與 vproxy 只允許 POST 到精確 restart endpoint。
    acl restart_method method POST
    acl gluetun_restart_path path,regsub(^/v[0-9.]+,) -m str /containers/@GLUETUN_CONTAINER_NAME@/restart
    acl vproxy_restart_path path,regsub(^/v[0-9.]+,) -m str /containers/@VPROXY_CONTAINER_NAME@/restart

    # 外部 network namespace consumer 額外只開放精確 inspect 與 restart。
    # inspect 用於確認它原本是否 running，確保 watcher 不會啟動已停止的服務。
    acl inspect_method method GET
    acl dependent_inspect_path path,regsub(^/v[0-9.]+,) -m str /containers/@DEPENDENT_CONTAINER_NAME@/json
    acl dependent_restart_path path,regsub(^/v[0-9.]+,) -m str /containers/@DEPENDENT_CONTAINER_NAME@/restart

    http-request allow if ping_method ping_path
    http-request allow if restart_method gluetun_restart_path
    http-request allow if restart_method vproxy_restart_path
    http-request allow if inspect_method dependent_inspect_path
    http-request allow if restart_method dependent_restart_path

    # 明確拒絕 start、stop、kill、remove、exec、任意 inspect 與所有 collection API。
    http-request deny

    default_backend docker-socket
