# Non-secret template for the opt-in LibreChat profile.
# Fill secrets in Portainer's existing ChatStack stack environment; do not commit them.
# Default-profile Compose rendering needs none of these new secrets. Profile startup
# refuses absent credentials; it also refuses the model placeholder in librechat.yaml.
# Do NOT mount ChatStack's whole .env into LibreChat or RAG API.

# Persist these independently generated keys across container recreation.
# CREDS_KEY: 32 random bytes encoded as 64 hex characters.
# CREDS_IV: 16 random bytes encoded as 32 hex characters.
# JWT secrets: each at least 32 independent random bytes (64 hex recommended).
# App and RAG share LIBRECHAT_JWT_SECRET; refresh secret is app-only.
LIBRECHAT_CREDS_KEY=
LIBRECHAT_CREDS_IV=
LIBRECHAT_JWT_SECRET=
LIBRECHAT_JWT_REFRESH_SECRET=

# All database passwords must be independent random hex values (64 hex recommended).
# Mongo app password is embedded in a URI, so only hex avoids URI escaping ambiguity.
# Root account is initialization/administration only, never used by LibreChat.
# Fixed Mongo app user/database: librechat_app / LibreChat.
# Fixed PostgreSQL user/database: librechat_rag / librechat_rag.
LIBRECHAT_MONGO_ROOT_PASSWORD=
LIBRECHAT_MONGO_APP_PASSWORD=
LIBRECHAT_POSTGRES_PASSWORD=
# Meilisearch production mode requires a master key of at least 16 bytes.
LIBRECHAT_MEILI_MASTER_KEY=

# Dedicated new-api consumer key, not an admin token.
LIBRECHAT_NEW_API_KEY=
# Edit models.default in librechat.yaml to the actual tested vision/tool-calling ID.
# Model names in this pinned release do not support env interpolation.

# Set the real pilot URL (HTTPS proxy entrypoint or temporary reachable pilot URL).
# Both DOMAIN_CLIENT and DOMAIN_SERVER receive this value.
LIBRECHAT_PUBLIC_URL=
# Current server LAN address; override if the deployment host changes.
LIBRECHAT_HOST_BIND=192.168.10.13
LIBRECHAT_HOST_PORT=43006

# Native Tavily search and extract must both work. These are FULL endpoint URLs.
# A forwarding provider root must be converted into its actual /search and /extract URLs.
LIBRECHAT_TAVILY_API_KEY=
LIBRECHAT_TAVILY_SEARCH_URL=https://api.tavily.com/search
LIBRECHAT_TAVILY_EXTRACT_URL=https://api.tavily.com/extract

# Remote OpenAI-compatible embeddings gateway, including its API /v1 prefix.
# This may use a dedicated key at the existing gateway; never reuse admin credentials.
# Validate native dimension/batch behavior before indexing; changing model requires reindexing.
LIBRECHAT_EMBEDDING_API_KEY=
LIBRECHAT_EMBEDDING_BASEURL=
LIBRECHAT_EMBEDDING_MODEL=qwen3-embedding-8b

# OPTIONAL: also uncomment the ocr block in librechat.yaml after supplying a real key.
# Without that block, digital PDF/DOCX use the built-in parser; scanned OCR is unverified.
LIBRECHAT_OCR_API_KEY=
LIBRECHAT_OCR_BASEURL=https://api.mistral.ai/v1

# Stage the two config files here before profile activation. Missing file binds fail;
# Portainer checkout paths are not relied on as permanent host-side bind sources.
LIBRECHAT_CONFIG_DIR=/home/df/appdata/ChatStack/librechat/config
# Local filesystem: database/index state plus data, logs, and skill directories.
# Evaluate filesystem suitability (Mongo recommends XFS) and prepare correct image ownership.
LIBRECHAT_LOCAL_ROOT=/home/df/appdata/ChatStack/librechat
# NAS attachment storage only: images and uploads, owned by 3000:3000 for the app.
LIBRECHAT_FILES_ROOT=/mnt/appdata/ChatStack/librechat
