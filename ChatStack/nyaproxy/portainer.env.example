# Import into the existing ChatStack stack's Environment variables, then fill in real values.
# Do not commit real credentials. Use different admin and application keys.
NYAPROXY_ADMIN_KEY=
NYAPROXY_API_KEY=
# JSON array, for example ["EXA_KEY_A","EXA_KEY_B"] (no outer single quotes in Portainer).
NYAPROXY_EXA_API_KEYS=

# Optional overrides; defaults already exist in docker-compose.yml.
NYAPROXY_HOST_PORT=43068
NYAPROXY_IMAGE_TAG=0.8.2

# Optional: route the existing Catalina/Claudia smart-search clients through the pool.
# SMART_SEARCH_EXA_BASE_URL=http://nyaproxy-gateway:8080/api/exa
# SMART_SEARCH_EXA_API_KEY=<same value as NYAPROXY_API_KEY>
# SMART_SEARCH_EXA_TIMEOUT_SECONDS=120
