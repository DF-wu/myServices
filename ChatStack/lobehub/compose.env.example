# Import into the existing ChatStack Portainer Environment; retain other stack variables.
# Fill actual deployment settings only in Portainer or an ignored compose.env.local.
# generate-secrets.mjs generates the password, vault/auth secrets and matching JWKS.
LOBEHUB_POSTGRES_PASSWORD=
LOBEHUB_KEY_VAULTS_SECRET=
LOBEHUB_AUTH_SECRET=
LOBEHUB_JWKS_KEY=
LOBEHUB_JWKS_PUBLIC_KEY=
LOBEHUB_GATEWAY_SERVICE_TOKEN=
LOBEHUB_APP_URL=
LOBEHUB_AGENT_GATEWAY_URL=
LOBEHUB_DEVICE_GATEWAY_URL=
LOBEHUB_NEWAPI_API_KEY=
LOBEHUB_AUTH_ALLOWED_EMAILS=
LOBEHUB_S3_ENDPOINT=
LOBEHUB_S3_BUCKET=
LOBEHUB_S3_ACCESS_KEY_ID=
LOBEHUB_S3_SECRET_ACCESS_KEY=

# Optional settings; values below are generic recipe defaults.
# LOBEHUB_HOST_PORT=43069
# LOBEHUB_AGENT_GATEWAY_HOST_PORT=43070
# LOBEHUB_DEVICE_GATEWAY_HOST_PORT=43071
# Keep loopback until access restrictions are configured for both gateways.
# LOBEHUB_GATEWAY_BIND_IP=127.0.0.1
# LOBEHUB_CHAT_MODEL=deepseek-v4-flash
# LOBEHUB_NEWAPI_MODEL_LIST=-all,+deepseek-v4-flash
# Private-IP exceptions, if required: fill actual values only in Portainer.
# LOBEHUB_SSRF_ALLOW_IP_ADDRESS_LIST=
