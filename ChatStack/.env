EXTRA_MODELS=
TGBOT_TOKEN=
OPENAPI_KEY=
TGBOTWEB_HOOK=

# lilac-mono / ChatStack shared LLM upstreams
# OPENAI_BASE_URL is for native OpenAI-format requests.
OPENAI_BASE_URL=
# OPENAI_COMPATIBLE_BASE_URL is shared by Catalina and Claudia.
# For the Anthropic-native path in lilac-mono, docker-compose currently reuses this same base URL.
# That upstream must accept BOTH OpenAI-compatible and Anthropic Messages API requests.
OPENAI_COMPATIBLE_BASE_URL=

# Per-instance keys used by lilac-mono.
OPENAI_API_KEY_CATALINA=
OPENAI_API_KEY_CLAUDIA=
OPENAI_COMPATIBLE_API_KEY_CATALINA=
OPENAI_COMPATIBLE_API_KEY_CLAUDIA=

# Optional standalone Anthropic vars are kept here for reference only.
# Current docker-compose maps ANTHROPIC_* from the OpenAI-compatible base/key per instance.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

DISCORD_TOKEN=
DISCORD_TOKEN_CLAUDIA=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET_CLAUDIA=
GITHUB_WEBHOOK_PORT=
GITHUB_WEBHOOK_PATH=
GITHUB_TOKEN_CLAUDIA=
EXA_API_KEY=
EXA_API_BASE_URL=
TAVILY_API_BASE_URL=
TAVILY_API_KEY=
LILAC_LLM_WIRE_DEBUG=

# cline-pass-switcher optional overrides. Normally empty: the live config (Cline Pass key, proxyKey,
# per-model pins) lives in /mnt/appdata/ChatStack/cline-pass-switcher/data/config.json on the host.
CLINE_PASS_KEY=
CLINE_PASS_SWITCHER_PROXY_KEY=
CLINE_PASS_SWITCHER_PUBLIC_BASE_URL=

# Lilac native web UI owner login (shared by both instances) and per-instance session secrets.
# Rotate the hash with: bun -e 'console.log(await Bun.password.hash(prompt("pw"), {algorithm:"argon2id"}))'
# Single quotes keep the literal $ signs of the Argon2id hash out of Compose interpolation.
LILAC_NATIVE_LOCAL_USERNAME=df
LILAC_NATIVE_LOCAL_PASSWORD_HASH='$argon2id$v=19$m=65536,t=2,p=1$SMa12uUxPdmMTpgO+32x6W3uy34mYVGl8cVSn4f5oWA$uVDZZw6OIetOaju1OXwzcC5xBWUM2amTy6+CsEDBr+E'
LILAC_NATIVE_SESSION_SECRET=LwijYOrlDtUtBbqrEE7kAg1F6yzUiF4mH77g3og_OVY
LILAC_NATIVE_SESSION_SECRET_CLAUDIA=Zk0T2Up0KLDFqG0W_R1Vz3SAp1lyFcRz7zxB2VtZpgY
