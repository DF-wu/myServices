# Merge selected values into the EXISTING ChatStack Portainer Environment.
# Do not replace the stack's full environment with this SearXNG-only template.
# Required: set the same private LAN address used by the current VPN port binding.
# Leave blank until configured; do not use a public address or 0.0.0.0.
SEARXNG_BIND_IP=

# Optional overrides; the Compose defaults are shown here.
SEARXNG_HOST_PORT=43072
SEARXNG_VPN_COUNTRY=Japan