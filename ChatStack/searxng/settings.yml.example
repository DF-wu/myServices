# Never mount this example directly: install a local random secret first.
# Disabled engines failed current VPN probes or are slower optional sources.
use_default_settings:
  engines:
    keep_only:
    - google
    - bing
    - brave
    - duckduckgo
    - yahoo
    - qwant
    - wikipedia
    - wikidata
    - github
    - gitlab
    - codeberg
    - docker hub
    - pypi
    - npm
    - mdn
    - stackoverflow
    - arch linux wiki
    - arxiv
    - pubmed
    - crossref
    - semantic scholar
    - google scholar
    - google news
    - bing news
    - duckduckgo news
    - google images
    - bing images
    - youtube
    - bilibili
    - currency
general:
  debug: false
  instance_name: Private Search
  enable_metrics: true
  open_metrics: ''
search:
  default_lang: zh-TW
  safe_search: 0
  autocomplete: duckduckgo
  autocomplete_min: 3
  favicon_resolver: ''
  formats:
  - html
  - json
server:
  secret_key: __GENERATE_LOCAL_SECRET__
  limiter: true
  public_instance: false
  image_proxy: true
  method: POST
ui:
  default_theme: simple
  query_in_title: false
  results_on_new_tab: true
  theme_args:
    simple_style: auto
  default_locale: zh-Hant-TW
valkey:
  url: valkey://127.0.0.1:6379/0
outgoing:
  request_timeout: 6.0
  max_request_timeout: 15.0
  pool_connections: 100
  enable_http2: true
  retries: 0
plugins:
  searx.plugins.calculator.SXNGPlugin:
    active: true
  searx.plugins.hash_plugin.SXNGPlugin:
    active: true
  searx.plugins.unit_converter.SXNGPlugin:
    active: true
  searx.plugins.time_zone.SXNGPlugin:
    active: true
  searx.plugins.tracker_url_remover.SXNGPlugin:
    active: true
  searx.plugins.oa_doi_rewrite.SXNGPlugin:
    active: true
  searx.plugins.infinite_scroll.SXNGPlugin:
    active: true
engines:
- name: google
  disabled: true
  timeout: 6.0
- name: bing
  disabled: true
  timeout: 6.0
- name: brave
  disabled: false
  timeout: 6.0
  weight: 1.2
- name: duckduckgo
  disabled: false
  timeout: 6.0
  weight: 1.0
- name: yahoo
  disabled: false
  timeout: 6.0
  weight: 0.8
- name: qwant
  disabled: true
  timeout: 6.0
- name: wikipedia
  disabled: false
  timeout: 6.0
  display_type:
  - infobox
  - list
- name: wikidata
  disabled: true
  timeout: 6.0
- name: github
  disabled: false
  timeout: 6.0
- name: gitlab
  disabled: true
  timeout: 6.0
- name: codeberg
  disabled: true
  timeout: 8.0
- name: docker hub
  disabled: false
  timeout: 6.0
- name: pypi
  disabled: true
  timeout: 6.0
- name: npm
  disabled: false
  timeout: 6.0
- name: mdn
  disabled: false
  timeout: 6.0
- name: stackoverflow
  disabled: false
  timeout: 6.0
- name: arch linux wiki
  disabled: true
  timeout: 6.0
- name: arxiv
  disabled: false
  timeout: 8.0
- name: pubmed
  disabled: true
  timeout: 6.0
- name: crossref
  disabled: false
  timeout: 8.0
- name: semantic scholar
  disabled: false
  timeout: 8.0
- name: google scholar
  disabled: true
  timeout: 8.0
- name: google news
  disabled: true
  timeout: 6.0
- name: bing news
  disabled: false
  timeout: 6.0
- name: duckduckgo news
  disabled: false
  timeout: 6.0
- name: google images
  disabled: true
  timeout: 6.0
- name: bing images
  disabled: false
  timeout: 6.0
- name: youtube
  disabled: false
  timeout: 6.0
- name: bilibili
  disabled: false
  timeout: 6.0
- name: currency
  disabled: false
  timeout: 6.0
