# Checklist for Portainer stack Environment; keep actual values private.
# A local .env or shell environment is not automatically passed to Portainer.
HTTP_PORT=58090
# Host attachment source; blank uses Compose's existing path fallback.
# The current Compose file always includes the attachment bind.
ATTACHMENT_DIR=

# Bootstrap remains owner-managed. Blank AUTH_USERNAME uses Compose's fallback;
# blank AUTH_PASSWORD falls back to DF_PASSWORD. Blanks do not disable bootstrap.
AUTH_USERNAME=
AUTH_PASSWORD=
DF_PASSWORD=

# Not wired: DB_PASSWORD, DB_ROOT_PASSWORD, DB_DATA_DIR, BIND_IP, NGINX_CONFIG_PATH.
# DB credentials remain literal Compose settings; these are not override options.
