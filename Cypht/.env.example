# Import into Portainer stack variables; blanks deliberately require operator input.
BIND_IP=
HTTP_PORT=58090
DB_DATA_DIR=/home/df/_serverDataAndScript/cypht/mysql
ATTACHMENT_DIR=/mnt/appdata/Cypht/attachments
NGINX_CONFIG_PATH=/home/df/_serverDataAndScript/cypht/nginx.conf
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Initial deployment only: choose a username and a random 32+ character password.
# Use only ASCII letters/digits for BOTH; upstream shell expands these unquoted.
# After verifying login, empty/remove both and recreate the app container.
AUTH_USERNAME=
AUTH_PASSWORD=
