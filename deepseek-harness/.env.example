# deepseek-harness deployment defaults
# 本機使用：cp .env.example .env
# Portainer Repository Stack：需要覆寫的值直接填到 Stack 的 Environment variables，不填就吃 compose 預設值。

TZ=Asia/Taipei

# image tag：0.2.4 = 純淨版；0.2.4-market = 預裝 dshmarket 插件市場。
DSH_IMAGE_TAG=0.2.4

# host port；容器內固定 3080（上游 HEALTHCHECK 寫死）。
DSH_HOST_PORT=43065

# 底下會建立 dsh / snapshots / workspace / browser 四個子目錄。
DSH_APPDATA_DIR=/mnt/appdata/deepseek-harness

# 留空（建議）：首次造訪走 /setup 初始化口令，口令持久化在 dsh 資料卷。
AUTH_TOKEN=

# 只有在 NPM / Cloudflare Tunnel 等可信反代後面才設 1。
TRUST_PROXY=0
# 對外 hostname，例如 dsh.dfder.tw；多個用逗號分隔。
PUBLIC_HOST=

DSH_DESKTOP_ENABLED=1
DSH_IDLE_TIMEOUT_MINUTES=30
DSH_VERSIONS_MIN_FREE_MB=1536

HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1
