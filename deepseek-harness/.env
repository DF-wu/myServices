# ========================================================
# deepseek-harness deployment defaults
# 此檔為部署用預設值，由同目錄 docker-compose.yml 的 env_file 載入。
# Portainer Repository Stack：隨 repo 拉取此檔；需要覆寫的值可填到 Stack Environment。
# AUTH_TOKEN、SESSION_SECRET 與代理 URL 只引用同名環境變數；實際秘密請在 Portainer 設定，不寫進 repo。
# 注意：桌面、反代等設定在 Admin 存檔後以 /root/.dsh/gateway.config.json 為準，這裡只是初始預設值。
# ========================================================

TZ=Asia/Taipei

# image tag
# latest-market = 預裝 dshmarket 社群應用市場 + 思考強度調節插件，跟隨上游最新版（目前使用）
# latest        = 純淨版，插件之後在 Admin 按需安裝
# 要鎖版本 / 回退時改成工程版本 tag（例如 0.2.4-market）或內建 DSH 版本 tag（例如 0.2.1-alpha.3-market）。
# 僅 linux/amd64。
DSH_IMAGE_TAG=latest-market

# host port；容器內固定 3080（上游 HEALTHCHECK 寫死）。
DSH_HOST_PORT=43065

# 底下會建立 dsh / snapshots / workspace / browser 四個子目錄。
DSH_APPDATA_DIR=/mnt/appdata/deepseek-harness

# 訪問認證碼（DSH Web、/admin、/vnc 共用）
# 留空（建議）：首次造訪導向「初始化訪問口令」頁面，口令以 0600 持久化到 dsh 資料卷，重建容器後依然有效。
# 在 Portainer Stack Environment 設定同名 AUTH_TOKEN：跳過初始化精靈直接使用該口令。
# 未設定或空值時保持留空；不要在這個檔案寫入實際口令。
AUTH_TOKEN=${AUTH_TOKEN:-}

# 選用：在 Portainer 設定同名 SESSION_SECRET 作為固定 session 簽章金鑰。
# 未設定或留空時，由服務自動產生並持久化到 dsh 資料卷的 .session_secret。
SESSION_SECRET=${SESSION_SECRET:-}

# 是否信任反代轉發的 X-Forwarded-For（預設 1，預期放在 NPM / Cloudflare Tunnel 後面）
# 若 43065 直接暴露給不可信網路請改 0，否則 XFF 可被偽造讓登入限流失效。
TRUST_PROXY=1

# 對外 hostname 白名單（逗號分隔，用於 WebSocket 同源校驗），例如 dsh.dfder.tw
# 上游逐字精確比對，不支援 `*` 萬用字元；反代保留原始 Host 頭時留空即可。
PUBLIC_HOST=

# 線上切換 DSH 核心版本前的磁碟水位門檻（MB）
DSH_VERSIONS_MIN_FREE_MB=1536

# ─────────────────────────────────────────────────────────────
# 出站網路代理（選用：模型 API、Web 搜尋或插件下載走代理）
# DSH 0.1.5-rc.1 起原生遵循出站代理設定
# URL 可能包含代理帳密，因此只讀 Portainer 的同名變數；未設定時留空。
# ─────────────────────────────────────────────────────────────
HTTP_PROXY=${HTTP_PROXY:-}
HTTPS_PROXY=${HTTPS_PROXY:-}
ALL_PROXY=${ALL_PROXY:-}
NO_PROXY=localhost,127.0.0.1

# ─────────────────────────────────────────────────────────────
# 以下選用參數可在此取消註解，由 env_file 注入；如 compose 的 environment 也有同名設定，以 environment 為準。
# ─────────────────────────────────────────────────────────────
# SESSION_SECRET 也是讀取 Portainer 同名變數；留空時首次啟動自動產生並持久化。
# DSH_DESKTOP_ENABLED=1              # 內建 Chromium 圖形桌面（1 開啟 / 0 關閉）
# DSH_IDLE_TIMEOUT_MINUTES=30        # 桌面閒置休眠分鐘數；填 0 無效（會回到 30），永不休眠請在 Admin 設
# DSH_DESKTOP_WIDTH=1920
# DSH_DESKTOP_HEIGHT=1080
# DSH_SCREENSHOT_QUALITY=high        # AI 截圖預設畫質（high / medium / low）
# DSH_SCREENSHOT_DIR=                # AI 截圖預設存放子目錄（相對工作區，留空 = 根目錄）
