# Portainer Git stack: enter these values under Stack > Environment variables.
# Local Compose only: copy this file to ~/workspace/myServices/homepage/.env.
# Never commit a populated .env file.

HOMEPAGE_HOST_PORT=33080
HOMEPAGE_CONFIG_DIR=/mnt/appdata/homepage/config
# Theme preset selector. Use exactly one ID, then Pull and redeploy in Portainer.
# dracula       = dark purple/pink Dracula; preserves the current background
# obsidian      = dark slate glass with emerald/cyan accents; recommended daily use
# nord          = dark arctic blue-gray; calm and low-fatigue
# cyber         = dark near-black cyan/lime NOC console
# minimal       = dark neutral zinc; low decoration and fast scanning
# graphite      = dark charcoal with amber focus; dense catalog
# rose-pine     = dark mauve/rose/gold/foam; warmer personal dashboard
# daylight      = light white workspace with blue navigation and green status
# paper         = light neutral catalog with cobalt/coral accents
# high-contrast = dark black/white with cyan/yellow; maximum legibility
HOMEPAGE_THEME=dracula
# Portainer uses these defaults to fetch the selected preset from GitHub.
HOMEPAGE_THEME_REF=master
HOMEPAGE_THEME_REPOSITORY=DF-wu/myServices

# Comma-separated, no spaces. Include exact hostnames and ports used in browser.
# Example: hp.dfder.tw,axolotl.newhome:33080,192.168.10.13:33080
HOMEPAGE_ALLOWED_HOSTS=hp.dfder.tw,localhost:3000,127.0.0.1:3000,axolotl.newhome:33080

PUID=1000
PGID=1000
LOG_LEVEL=info
LOG_TARGETS=both

# Widget secrets: examples only. Fill only the widgets DF approves.
HOMEPAGE_VAR_PORTAINER_KEY=
HOMEPAGE_VAR_NPM_USERNAME=
HOMEPAGE_VAR_NPM_PASSWORD=
HOMEPAGE_VAR_ADGUARD_USERNAME=
HOMEPAGE_VAR_ADGUARD_PASSWORD=
HOMEPAGE_VAR_JELLYFIN_API_KEY=
HOMEPAGE_VAR_IMMICH_API_KEY=
HOMEPAGE_VAR_NEXTCLOUD_TOKEN=
HOMEPAGE_VAR_PHOTOPRISM_KEY=
HOMEPAGE_VAR_PHOTOPRISM_USERNAME=
HOMEPAGE_VAR_PHOTOPRISM_PASSWORD=
HOMEPAGE_VAR_QBITTORRENT_USERNAME=
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=
HOMEPAGE_VAR_HOMEASSISTANT_TOKEN=
HOMEPAGE_VAR_TRUENAS_API_KEY=
HOMEPAGE_VAR_TAILSCALE_API_KEY=

HOMEPAGE_VAR_BACKREST_USERNAME=
HOMEPAGE_VAR_BACKREST_PASSWORD=
HOMEPAGE_VAR_UPTIME_KUMA_SLUG=
HOMEPAGE_VAR_SPEEDTEST_API_KEY=
HOMEPAGE_VAR_CLOUDFLARED_ACCOUNT_ID=
HOMEPAGE_VAR_CLOUDFLARED_TUNNEL_ID=
HOMEPAGE_VAR_CLOUDFLARED_API_TOKEN=
HOMEPAGE_VAR_GRAFANA_USERNAME=
HOMEPAGE_VAR_GRAFANA_PASSWORD=
HOMEPAGE_VAR_SUWAYOMI_USERNAME=
HOMEPAGE_VAR_SUWAYOMI_PASSWORD=
