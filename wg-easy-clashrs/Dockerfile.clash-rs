FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

ARG TARGETARCH
ARG CLASH_RS_VERSION
ARG CLASH_RS_AMD64_SHA256
ARG CLASH_RS_ARM64_SHA256

RUN apk add --no-cache ca-certificates curl iproute2 nftables tzdata yq \
    && case "${TARGETARCH}" in \
         amd64) \
           asset="clash-rs-x86_64-unknown-linux-musl"; \
           expected="${CLASH_RS_AMD64_SHA256}" ;; \
         arm64) \
           asset="clash-rs-aarch64-unknown-linux-musl"; \
           expected="${CLASH_RS_ARM64_SHA256}" ;; \
         *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && test -n "${CLASH_RS_VERSION}" \
    && test -n "${expected}" \
    && curl --fail --location --retry 3 \
         "https://github.com/Watfaq/clash-rs/releases/download/v${CLASH_RS_VERSION}/${asset}" \
         --output /usr/local/bin/clash-rs \
    && echo "${expected}  /usr/local/bin/clash-rs" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/clash-rs

COPY config/config.example.yaml /usr/local/share/clash-rs/config.example.yaml
COPY scripts/clash-rs-entrypoint.sh /usr/local/sbin/clash-rs-entrypoint.sh
COPY scripts/gateway-rules.sh /usr/local/sbin/gateway-rules.sh

RUN chmod 0755 /usr/local/sbin/clash-rs-entrypoint.sh /usr/local/sbin/gateway-rules.sh

ENTRYPOINT ["/usr/local/sbin/clash-rs-entrypoint.sh"]
