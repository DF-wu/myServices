# Portainer must use an absolute path on the Docker host.
APPDATA_DIR=/opt/appdata/wg-easy-clashrs
WG_PORT=51820
WG_UI_BIND=127.0.0.1
WG_UI_PORT=51821
TZ=Asia/Taipei

# Required on first start. The generated config is retained under APPDATA_DIR.
CLASH_SUBSCRIPTION_URL=https://replace-with-your-clash-subscription.example/subscription

# Supply-chain pins for the locally built ClashRS image.
CLASH_RS_VERSION=0.10.8
CLASH_RS_AMD64_SHA256=551f3f9e71a8f344416219ba300af2f3aced6f1e1d2eee6fdc1f256e7a011776
CLASH_RS_ARM64_SHA256=c3ebf9da1a89d5fce30bb64058a2143e4c67e0eb3092343bc9c768420c0a2072
